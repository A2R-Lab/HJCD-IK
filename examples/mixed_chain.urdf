<?xml version="1.0"?>
<!-- Analytic demonstration, not a model of a physical robot. Coordinates are radians, then metres. -->
<robot name="mixed_chain">
  <link name="link0" />
  <link name="link1">
    <inertial><mass value="1" /><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0" /></inertial>
    <collision><origin xyz="0 0 0" /><geometry><sphere radius="0.02" /></geometry></collision>
  </link>
  <link name="link2">
    <inertial><mass value="1" /><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0" /></inertial>
    <collision><origin xyz="0 0 0" /><geometry><sphere radius="0.02" /></geometry></collision>
  </link>
  <link name="link3">
    <inertial><mass value="1" /><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0" /></inertial>
    <collision><origin xyz="0 0 0" /><geometry><sphere radius="0.02" /></geometry></collision>
  </link>
  <joint name="j0" type="revolute">
    <parent link="link0" /><child link="link1" />
    <origin xyz="0.2 0.1 0.15" rpy="0.1 0.2 -0.1" />
    <axis xyz="0 0.6 0.8" /><limit lower="-2" upper="2" effort="10" velocity="1" />
  </joint>
  <joint name="j1" type="prismatic">
    <parent link="link1" /><child link="link2" />
    <origin xyz="0.2 0.1 0.15" rpy="0.1 0.2 -0.1" />
    <axis xyz="0.6 0 0.8" /><limit lower="0" upper="0.5" effort="10" velocity="1" />
  </joint>
  <joint name="tool" type="fixed">
    <parent link="link2" /><child link="link3" />
    <origin xyz="0.2 0.1 0.15" rpy="0.1 0.2 -0.1" />
  </joint>
</robot>
