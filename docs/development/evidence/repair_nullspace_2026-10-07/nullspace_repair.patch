+#if defined(HJCD_HAS_COLLISION)
+// Nullspace repair (C2, 2026-10-07): for an accurate-but-colliding candidate, push the penetrating spheres
+// out along the environment normals WITHOUT moving the end effector, then let the LM re-project.
+//   d_i   = sum_s depth_s * n_s . (z_i x (p_s - o_i))   over joints i at or before the sphere's anchor
+//   d_n   = d - J^T (J J^T)^-1 J d                      (J = unscaled 6xN geometric EE Jacobian)
+//   alpha = (depth* + margin) / (n* . J_{s*} d_n)        (deepest sphere s* clears by `margin`)
+// Entered by the full warp; every lane returns the same verdict. Writes s_x = clamp(q_acc + alpha d_n) when
+// it succeeds. Fails (returns false) when no sphere penetrates the ENVIRONMENT (self-collision only: no
+// normals), when the nullspace cannot move the deepest sphere outward, or when J J^T is not SPD. Joints
+// are treated as revolute about their z axis, as the LM Jacobian does.
+template<typename T>
+__device__ bool warp_nullspace_repair(LMWarpScratch<T>* st, const CCEnv& env, T margin_m)
+{
+    constexpr int NS = CC_NUM_SPHERES;
+    const int lane = threadIdx.x & 31;
+    const T* s_jointX = st->s_jointX;
+    grid_collision::warp::collision_distance<T>(s_jointX, env, st->cc_dist, st->cc_normal, st->cc_pos);
+    // deepest penetrating sphere (warp argmin over signed clearance)
+    float lmin = 1e30f; uint32_t lidx = UINT32_MAX;
+    for (int sph = lane; sph < NS; sph += WARP_SIZE)
+        if (st->cc_dist[sph] < lmin) { lmin = st->cc_dist[sph]; lidx = (uint32_t)sph; }
+    float wmin;
+    const uint32_t widx = glass::warp::argmin_pair(lmin, lidx, wmin);
+    if (widx == UINT32_MAX || wmin >= 0.0f) return false;          // nothing penetrates the environment
+    // push direction in joint space (lane i owns joint i)
+    if (lane < N) {
+        const T* Xi = &s_jointX[16 * lane];
+        const T zi0 = Xi[8], zi1 = Xi[9], zi2 = Xi[10], oi0 = Xi[12], oi1 = Xi[13], oi2 = Xi[14];
+        T acc = (T)0;
+        for (int sph = 0; sph < NS; ++sph) {
+            const float dist = st->cc_dist[sph];
+            if (dist >= 0.0f || grid_collision::sphere_anchor[sph] < lane) continue;
+            const T r0 = (T)st->cc_pos[3 * sph] - oi0, r1 = (T)st->cc_pos[3 * sph + 1] - oi1, r2 = (T)st->cc_pos[3 * sph + 2] - oi2;
+            const T v0 = zi1 * r2 - zi2 * r1, v1 = zi2 * r0 - zi0 * r2, v2 = zi0 * r1 - zi1 * r0;
+            acc += (T)(-dist) * ((T)st->cc_normal[3 * sph] * v0 + (T)st->cc_normal[3 * sph + 1] * v1 + (T)st->cc_normal[3 * sph + 2] * v2);
+        }
+        st->d_push[lane] = acc;
+        // unscaled geometric EE Jacobian column i (the LM's J is row-scaled; rebuilt at the loop top anyway)
+        const T* Cn = &s_jointX[EE_IDX * 16];
+        const T r0 = Cn[12] - oi0, r1 = Cn[13] - oi1, r2 = Cn[14] - oi2;
+        st->J[0 * N + lane] = zi1 * r2 - zi2 * r1; st->J[1 * N + lane] = zi2 * r0 - zi0 * r2; st->J[2 * N + lane] = zi0 * r1 - zi1 * r0;
+        st->J[3 * N + lane] = zi0; st->J[4 * N + lane] = zi1; st->J[5 * N + lane] = zi2;
+    }
+    __syncwarp(FULL_WARP_MASK);
+    // b = J d (6), A = J J^T (6x6) into the LM's normal-equation scratch (N*N >= 36, N >= 6)
+    if (lane < 6) { T b = (T)0; for (int i = 0; i < N; ++i) b += st->J[lane * N + i] * st->d_push[i]; st->rhsd_sh[lane] = b; }
+    for (int e = lane; e < 36; e += WARP_SIZE) {
+        const int k = e / 6, l = e % 6; T a = (T)0;
+        for (int i = 0; i < N; ++i) a += st->J[k * N + i] * st->J[l * N + i];
+        st->Ad_sh[e] = a;
+    }
+    __syncwarp(FULL_WARP_MASK);
+    glass::warp::posv<T, 6, /*NRHS=*/1, /*REGULARIZE=*/true, /*CHECK=*/true, /*REG_DIAG=*/true>(
+        st->Ad_sh, st->rhsd_sh, (T)1e-6, &st->s_fail);
+    __syncwarp(FULL_WARP_MASK);
+    const bool spd_ok = (st->s_fail == 0);
+    if (lane < N) {
+        T dn = st->d_push[lane];
+        if (spd_ok) for (int k = 0; k < 6; ++k) dn -= st->J[k * N + lane] * st->rhsd_sh[k];
+        st->d_null[lane] = dn;
+    }
+    __syncwarp(FULL_WARP_MASK);
+    // predicted outward motion of the deepest sphere and the step size
+    if (lane == 0) {
+        const int sph = (int)widx;
+        const T px = (T)st->cc_pos[3 * sph], py = (T)st->cc_pos[3 * sph + 1], pz = (T)st->cc_pos[3 * sph + 2];
+        T v0 = (T)0, v1 = (T)0, v2 = (T)0, amax = (T)0;
+        for (int i = 0; i < N; ++i) {
+            const T a = st->d_null[i]; amax = fmax(amax, fabs(a));
+            if (grid_collision::sphere_anchor[sph] < i) continue;
+            const T* Xi = &s_jointX[16 * i];
+            const T r0 = px - Xi[12], r1 = py - Xi[13], r2 = pz - Xi[14];
+            v0 += a * (Xi[9] * r2 - Xi[10] * r1); v1 += a * (Xi[10] * r0 - Xi[8] * r2); v2 += a * (Xi[8] * r1 - Xi[9] * r0);
+        }
+        const T proj = (T)st->cc_normal[3 * sph] * v0 + (T)st->cc_normal[3 * sph + 1] * v1 + (T)st->cc_normal[3 * sph + 2] * v2;
+        const T depth = (T)(-wmin);
+        T alpha = (proj > (T)1e-9) ? (depth + margin_m) / proj : (T)0;
+        if (alpha * amax > (T)0.5) alpha = (T)0.5 / amax;            // never more than 0.5 rad on any joint
+        st->ns_scalar[0] = depth; st->ns_scalar[1] = proj; st->ns_scalar[2] = alpha; st->ns_scalar[3] = amax;
+        st->ns_sphere = sph;
+    }
+    __syncwarp(FULL_WARP_MASK);
+    if (!(st->ns_scalar[2] > (T)0)) return false;                   // uniform: shared scalar
+    if (lane < N) {
+        const double2 L = c_joint_limits[lane];
+        st->s_x[lane] = clamp_val<T>(st->q_acc[lane] + st->ns_scalar[2] * st->d_null[lane], (T)L.x, (T)L.y);
+    }
+    __syncwarp(FULL_WARP_MASK);
+    return true;
+}
